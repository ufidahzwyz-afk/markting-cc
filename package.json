{
  "name": "boran-marketing-ops",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=24 <25", "npm": ">=11 <12" },
  "packageManager": "npm@11.9.0",
  "workspaces": ["apps/ops", "packages/ui"],
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "npm run build --workspace @boran/ops",
