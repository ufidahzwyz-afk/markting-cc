{
  "name": "boran-marketing-ops",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25",
    "npm": ">=11 <12"
  },
  "packageManager": "npm@11.9.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "npm run build --workspace @boran/ops && npm run build --workspace @boran/public-site",
    "typecheck": "node scripts/typecheck.mjs",
    "test": "node scripts/test.mjs",
    "check": "npm run typecheck && npm test && npm run build",
    "db:migrate": "tsx scripts/database.ts migrate",
    "db:seed": "tsx scripts/database.ts seed",
    "test:integration": "node --import tsx --test --test-concurrency=1 tests/integration/*.test.ts",
    "dev:services": "node scripts/dev-services.mjs",
    "db:prepare": "tsx scripts/prepare-development.ts"
  },
  "devDependencies": {
    "@types/node": "24.10.1",
    "typescript": "5.9.3",
    "tsx": "4.20.6",
    "@electric-sql/pglite": "0.3.14"
  }
}
