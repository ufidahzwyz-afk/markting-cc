    "check": "npm run typecheck && npm test && npm run build"
  },
  "devDependencies": {
    "@types/node": "24.10.1",
    "typescript": "5.9.3",
    "tsx": "4.20.6",
    "@electric-sql/pglite": "0.3.14"
  }
}
