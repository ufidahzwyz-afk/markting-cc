# Local isolated development only. Never use mock identity in production.
APP_ENV=development
AUTH_MODE=mock
AI_MODE=mock
TZ=Asia/Shanghai
DATABASE_URL=postgresql://boran_dev:local_development_only@localhost:5432/boran_dev
OPS_BASE_URL=http://localhost:3000
PUBLIC_BASE_URL=http://localhost:3001
WRITE_ENABLED=false
ADS_WRITE_ENABLED=false
PUBLISH_ENABLED=false
PRODUCTION_PII_AUTOMATION_ENABLED=false
WORKER_PORT=3002
BROWSER_RUNTIME_PORT=3003
# Platform credentials are submitted to the local encrypted store; only references enter the database.
# No real secrets, contacts, cookies, or original business documents belong here.
BORAN_MODE=mock
PUBLIC_ALLOWED_PATH_PREFIXES=/service,/industry,/case,/article
DATABASE_POOL_MAX=5
# Optional real identity settings (used only with AUTH_MODE=oidc and BORAN_MODE=live).
# OIDC_ISSUER=https://identity.example.invalid
# OIDC_AUDIENCE=boran-ops
# OIDC_JWKS_URL=https://identity.example.invalid/.well-known/jwks.json
# BORAN_ORG_ID=<provisioned-organization-uuid>
# PUBLIC_EVENTS_CLEANUP_ACTOR_ID=<active-owner-service-member-uuid>
# PUBLIC_RATE_LIMIT_SECRET=<at-least-32-random-characters; private runtime only>
# PII_ENCRYPTION_KEY=<32-byte key encoded as base64; private runtime only>
# PII_HMAC_KEY=<independent 32-byte base64 key; private runtime only>
# Real-read Mac overlay: infra/compose.live-readonly.yaml. Add secrets through the settings page, never here.
# BORAN_SECRET_STORE_ROOT=/absolute/private/path/store
# BORAN_SECRET_KEY_FILE=/absolute/private/path/master.key
# BORAN_SERVICE_KEY_FILE=/absolute/private/path/service.key
# BORAN_SOURCE_STORE_ROOT=/absolute/private/path/sources
# BORAN_SOURCE_ROOT=/absolute/private/path/sources
# BROWSER_IDENTITY_MODE=local_service
# BROWSER_LOCAL_SERVICE_AUDIENCE=http://browser-runtime:3003
# BROWSER_LOCAL_REPLAY_ROOT=/absolute/private/path/service-replay
# BROWSER_LOCAL_ALLOWED_ROLES=worker,ops
# BROWSER_LOCAL_SERVICES={"boran-worker":{"orgIds":["<existing-org-uuid>"],"roles":["worker"]},"boran-ops":{"orgIds":["<existing-org-uuid>"],"roles":["ops"]}}
# BORAN_EGRESS_ALLOW_HOSTS=api.deepseek.com,www.googleapis.com,oauth2.googleapis.com,docs.google.com,drive.google.com,chatgpt.com,auth.openai.com,cdn.oaistatic.com
# Optional deployment-reviewed browser recipes. Paths refer to files in the existing private secrets volume.
# BROWSER_RECIPES_FILE=/var/lib/boran/secrets/recipes/platforms.json
# BROWSER_CHATGPT_RECIPE_FILE=/var/lib/boran/secrets/recipes/chatgpt.json
# BROWSER_WEBSITE_ALLOWED_ORIGINS=https://<authorized-site-host>
# BROWSER_INTERACTION_SERVICES=boran-ops
# BROWSER_BAIDU_NATIVE_CONTRACT_VERSION=<verified-contract-version>
# BROWSER_BAIDU_REVIEW_CONTRACT_FILE=/var/lib/boran/secrets/recipes/baidu-review.json

# BROWSER_CAPABILITY_ARTIFACTS_FILE=/var/lib/boran/secrets/recipes/independent-capabilities.json
