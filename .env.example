# Local isolated development only. Never use mock identity in production.
APP_ENV=development
AUTH_MODE=mock
AI_MODE=mock
TZ=Asia/Shanghai
DATABASE_URL=postgresql://boran_dev:local_development_only@localhost:5432/boran_dev
OPS_BASE_URL=http://localhost:3000
PUBLIC_BASE_URL=http://localhost:3001
WRITE_ENABLED=false
ADS_WRITE_ENABLED=false
PUBLISH_ENABLED=false
PRODUCTION_PII_AUTOMATION_ENABLED=false
WORKER_PORT=3002
BROWSER_RUNTIME_PORT=3003
# Platform credentials are supplied through Secret Manager references later.
# No real secrets, contacts, cookies, or original business documents belong here.
BORAN_MODE=mock
PUBLIC_ALLOWED_PATH_PREFIXES=/service,/industry,/case,/article
DATABASE_POOL_MAX=5
# Optional real identity settings (used only with AUTH_MODE=oidc and BORAN_MODE=live).
# OIDC_ISSUER=https://identity.example.invalid
# OIDC_AUDIENCE=boran-ops
# OIDC_JWKS_URL=https://identity.example.invalid/.well-known/jwks.json
# BORAN_ORG_ID=<provisioned-organization-uuid>
# PUBLIC_EVENTS_CLEANUP_ACTOR_ID=<active-owner-service-member-uuid>
# PUBLIC_RATE_LIMIT_SECRET=<at-least-32-random-characters; private runtime only>
# PII_ENCRYPTION_KEY=<32-byte key encoded as base64; private runtime only>
# PII_HMAC_KEY=<independent 32-byte base64 key; private runtime only>
