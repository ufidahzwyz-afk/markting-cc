# Local isolated development only. Never use mock identity in production.
APP_ENV=development
AUTH_MODE=mock
AI_MODE=mock
TZ=Asia/Shanghai
DATABASE_URL=postgresql://boran_dev:local_development_only@localhost:5432/boran_dev
OPS_BASE_URL=http://localhost:3000
PUBLIC_BASE_URL=http://localhost:3001
WRITE_ENABLED=false
ADS_WRITE_ENABLED=false
PUBLISH_ENABLED=false
PRODUCTION_PII_AUTOMATION_ENABLED=false
WORKER_PORT=3002
BROWSER_RUNTIME_PORT=3003
# Platform credentials are supplied through Secret Manager references later.
# No real secrets, contacts, cookies, or original business documents belong here.
